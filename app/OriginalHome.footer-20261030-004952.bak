              opacity: 0.35,
              pointerEvents: 'none',
            }}
          />
        )}<div className="floatCard cardOne">오늘 뭐 해요?</div><div className="floatCard cardTwo">-고 싶어요</div><div className="floatCard cardThree"><small>♬</small>TOPIK II</div><div className="floatCard cardFour">진짜?</div><div
  className="ticket"

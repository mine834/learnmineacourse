              const availableSizes = sizes.includes(current)
                ? sizes
                : [...sizes, current].sort((a, b) => a - b)

              return (
                <Field key={key} label={label}>
                  <select
                    value={current}
                    onChange={e => change(key, Number(e.target.value))}
                    style={{
                      width: '100%',
                      padding: '12px 14px',
                      fontSize: 16,
                      background: '#ffffff',
                      color: '#243449',
                      border: '1px solid #cbd5e1',
                      borderRadius: 10,
                      cursor: 'pointer',
                    }}
                  >
                    {availableSizes.map(size => (
                      <option key={size} value={size}>
                        {size}px
                      </option>
                    ))}
                  </select>
                </Field>
              )
            })}
          </section>

          <section className="panel">
            <h2>03. Өнгө</h2>

            <Field label="Үндсэн цэнхэр">

.page{min-height:100vh;background:#fff;color:#18191b;font-family:Arial,sans-serif}
.header{background:linear-gradient(110deg,#c8e3fc,#e5f0fa);border-bottom:1px solid #ffffff90}
.headerInner{max-width:1360px;min-height:76px;margin:auto;padding:12px 32px;display:flex;align-items:center;justify-content:space-between;gap:28px}
.logo{font:30px Georgia,'Times New Roman',serif;letter-spacing:-1px;color:#18191b;text-decoration:none;white-space:nowrap}.logo span{color:#009afa}
.nav{display:flex;gap:28px;align-items:center}.nav a{color:#25282c;font-size:14px;font-weight:600;text-decoration:none;white-space:nowrap}.nav a:hover,.nav a[aria-current=page]{color:#0879d1}
.actions{display:flex;align-items:center;gap:10px}.iconLink{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#ffffffb0;color:#24272b}.iconLink svg{width:22px;height:22px}
.container{width:min(960px,calc(100% - 48px));margin:auto}.intro{background:linear-gradient(110deg,#d1e7fc,#f0f3f7);padding:78px 0 84px}.eyebrow{color:#0879d1;font-size:12px;letter-spacing:2px;font-weight:600;margin:0 0 24px}.intro h1{font:400 clamp(44px,6vw,76px)/1.12 Georgia,'Times New Roman',serif;letter-spacing:-1.8px;margin:0 0 24px}.description{font-size:18px;line-height:1.7;color:#818793;max-width:800px;margin:0}
.content{padding-top:80px;padding-bottom:90px}.sectionTitle{font:400 clamp(29px,3.6vw,43px)/1.2 Georgia,'Times New Roman',serif;letter-spacing:-.8px;margin:0 0 18px;max-width:760px}.subtext{font-size:17px;line-height:1.7;color:#818793;margin:0 0 44px}.rowLink{display:grid;grid-template-columns:64px 1fr 24px;align-items:center;gap:24px;padding:34px 0;border-top:1px solid #dfe5ed;text-decoration:none;color:#18191b}.number{font-size:12px;color:#0879d1}.rowTitle{font:400 clamp(26px,3.2vw,38px)/1.25 Georgia,'Times New Roman',serif}.arrow{font-size:24px}.details{border-bottom:1px solid #dfe5ed}.details summary{cursor:pointer;list-style:none}.details summary::-webkit-details-marker{display:none}.details[open] .arrow{transform:rotate(180deg)}.detailsBody{padding:0 40px 30px 88px;font-size:16px;color:#718096;line-height:1.8}
.registration{margin-top:54px;background:#191a1c;border-radius:24px;padding:36px;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center;color:white}.registration .eyebrow{color:#e8cdbb;margin-bottom:18px}.registration h2{font:400 clamp(27px,3.4vw,40px)/1.25 Georgia,serif;margin:0 0 18px}.registration p{font-size:16px;line-height:1.7;color:#a3a7b0;max-width:600px}.registrationAction{text-align:center}.registrationAction small{display:block;color:#979da8;font-size:12px;margin-top:14px;line-height:1.5}.whiteButton{display:inline-flex;justify-content:center;padding:15px 25px;border-radius:40px;background:white;color:#191a1c;text-decoration:none;font-size:15px;border:0;white-space:nowrap}.whiteButton:disabled{opacity:.65}
.phraseList{margin-top:38px}.phraseRow{display:grid;grid-template-columns:64px 1fr 50px;align-items:center;gap:24px;padding:30px 0;border-top:1px solid #dfe5ed}.phraseRow:last-child{border-bottom:1px solid #dfe5ed}.korean{font-size:32px;font-weight:400;line-height:1.4;margin:0 0 12px}.meaning{font-size:18px;font-weight:600;margin:0 0 9px}.nuance{font-size:14px;color:#818793}.sound{border:1px solid #dfe5ed;background:white;border-radius:50%;width:48px;height:48px;display:grid;place-items:center;color:#0879d1;cursor:pointer}.sound svg{width:22px;height:22px}.sound:hover{background:#eaf5ff}.audioStatus{font-size:13px;color:#718096;line-height:1.5}.center{text-align:center;margin-top:28px}.blueButton{display:inline-flex;align-items:center;gap:20px;border:0;border-radius:36px;background:#009afa;box-shadow:0 4px 0 #0075c4;color:#fff;text-decoration:none;padding:15px 26px;font-size:16px;cursor:pointer}
.learningGrid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.learningCard{min-height:205px;display:flex;flex-direction:column;justify-content:space-between;padding:28px;border:1px solid #e1e6ec;border-radius:22px;background:#f9f9fb;color:#18191b;text-decoration:none;transition:background .2s}.learningCard:hover{background:#eaf5ff}.cardBottom{display:flex;justify-content:space-between;align-items:center;gap:16px}.cardBottom h2{font:400 clamp(25px,3vw,34px)/1.25 Georgia,serif;margin:0}
a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #0879d1;outline-offset:4px}
@media(max-width:800px){.headerInner{padding:14px 24px;gap:14px;flex-wrap:wrap}.nav{order:3;justify-content:center;width:100%;gap:20px;padding:8px 0}.intro{padding:54px 0 60px}.content{padding-top:52px;padding-bottom:60px}.registration{padding:28px;grid-template-columns:1fr}.registrationAction{text-align:left}}
@media(max-width:480px){.headerInner{padding:12px 20px}.logo{font-size:26px}.nav{gap:16px;justify-content:flex-start;overflow-x:auto}.nav a{font-size:12px}.iconLink{width:36px;height:36px}.container{width:calc(100% - 40px)}.intro h1{font-size:42px;letter-spacing:-1px}.description{font-size:16px}.rowLink{grid-template-columns:28px 1fr 20px;gap:14px;padding:26px 0}.rowTitle{font-size:27px}.detailsBody{padding:0 0 24px 42px;font-size:14px}.phraseRow{grid-template-columns:25px 1fr 42px;gap:14px;padding:24px 0}.korean{font-size:28px}.meaning{font-size:16px}.sound{width:40px;height:40px}.learningGrid{gap:12px}.learningCard{padding:20px;min-height:170px}.cardBottom h2{font-size:23px}.registration{padding:24px}.sectionTitle{font-size:30px}.subtext{font-size:16px}}

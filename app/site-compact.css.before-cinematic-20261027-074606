/* LEARNMINEA WHY SCROLL REVEAL */

@media (prefers-reduced-motion: no-preference) {
  .site .mineaWhyReveal > div:first-child,
  .site .mineaWhyReveal .reason {
    animation: mineaWhyEnter 650ms ease both;
    animation-timeline: view();
    animation-range: entry 0% entry 75%;
  }

  @keyframes mineaWhyEnter {
    from {
      opacity: 0;
      translate: 0 28px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  .site .mineaWhyReveal > div:first-child,
  .site .mineaWhyReveal .reason {
    animation: none !important;
    opacity: 1 !important;
    translate: none !important;
  }
}



/* Ticket layout fix */
.site .ticket {
  width: 300px;
  padding: 19px 18px;
  border-radius: 9px;
  overflow: hidden;
}

.site .ticketRows {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  gap: 10px;
  padding: 12px 0;
}

.site .ticketLabels,
.site .ticketValues {
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
}

.site .ticketLabels span,
.site .ticketValues strong {
  display: block;
  font-size: 11px;
  line-height: 1.5;
  white-space: nowrap;
}

.site .ticketLabels span {
  color: #85818b;
}

.site .ticketValues strong {
  text-align: right;
  color: #252235;
}

@media (max-width: 700px) {
  .site .ticket {
    width: 240px;
  }

  .site .ticketLabels span,
  .site .ticketValues strong {
    font-size: 9px;
  }
}


/* LEARNMINEA MOTION ONLY — NOTION INSPIRED */
/* Зөвхөн хөдөлгөөн. Өнгө, хэмжээ, layout өөрчлөхгүй. */

/* 1. Товч болон холбоосын зөөлөн hover */
.site .blueBtn,
.site .whiteBtn,
.site .textLink,
.site .nav a,
.site .footer a,
.site .search button {
  transition:
    opacity 200ms ease,
    filter 200ms ease;
}

.site .blueBtn:hover,
.site .whiteBtn:hover,
.site .search button:hover {
  filter: brightness(1.06);
}

.site .nav a:hover,
.site .footer a:hover,
.site .textLink:hover {
  opacity: 0.78;
}

/* 2. Картуудын зөөлөн хөдөлгөөн */
.site .studyCard,
.site .bookItem,
.site .testimonial,
.site .reason {
  transition:
    transform 200ms ease,
    box-shadow 200ms ease;
}

.site .studyCard:hover,
.site .bookItem:hover,
.site .testimonial:hover {
  transform: translateY(-4px);
}

/* 3. Hero дээрх солонгос үгтэй картууд */
.site .floatCard {
  animation: mineaGentleFloat 5s ease-in-out infinite;
}

.site .cardTwo {
  animation-delay: -1.2s;
}

.site .cardThree {
  animation-delay: -2.4s;
}

.site .cardFour {
  animation-delay: -3.6s;
}

@keyframes mineaGentleFloat {
  0%, 100% {
    translate: 0 0;
  }
  50% {
    translate: 0 -9px;
  }
}

/* 4. Hero-ийн Student Pass */
.site .ticket {
  animation: mineaTicketFloat 6s ease-in-out infinite;
}

@keyframes mineaTicketFloat {
  0%, 100% {
    translate: 0 0;
  }
  50% {
    translate: 0 -7px;
  }
}

/* 5. Accessibility: хөдөлгөөн багасгах тохиргоо */
@media (prefers-reduced-motion: reduce) {
  .site .floatCard,
  .site .ticket {
    animation: none !important;
  }

  .site .studyCard,
  .site .bookItem,
  .site .testimonial,
  .site .reason,
  .site .blueBtn,
  .site .whiteBtn,
  .site .textLink,
  .site .nav a,
  .site .footer a,
  .site .search button {
    transition: none !important;
  }
}



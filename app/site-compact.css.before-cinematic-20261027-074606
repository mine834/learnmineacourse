/* LEARNMINEA COURSE GENIESTUDIO V1 */
/* Зөвхөн сургалтын бүртгэлийн хэсэг */

section.registration.mineaRegistrationReveal {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: #ebf5ff;
  min-height: 520px;
  display: flex;
  align-items: center;
}

section.registration .mineaRegistrationLayout {
  position: relative;
  z-index: 2;
}

section.registration .mineacourseDecor {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

section.registration .mineacourseEmoji {
  position: absolute;
  display: block;
  font-size: clamp(38px, 5vw, 78px);
  line-height: 1;
  filter: drop-shadow(0 12px 12px rgba(34, 93, 145, .12));
  animation: mineacourseFloat 5s ease-in-out infinite;
}

section.registration .courseCloud {
  top: 10%;
  right: 14%;
  animation-delay: -.8s;
}

section.registration .coursePencil {
  bottom: 13%;
  right: 30%;
  transform: rotate(-22deg);
  animation-delay: -2s;
}

section.registration .courseLetter {
  top: 23%;
  right: 5%;
  animation-delay: -3s;
}

section.registration .courseStar {
  bottom: 18%;
  left: 5%;
  font-size: 45px;
  animation-delay: -1.5s;
}

section.registration .courseSmile {
  bottom: 8%;
  right: 7%;
  animation-delay: -2.7s;
}

@keyframes mineacourseFloat {
  0%, 100% { translate: 0 0; }
  50% { translate: 0 -16px; }
}

/* Scroll reveal — чимэглэлүүд ч бас дарааллаар гарч ирнэ */
@media (prefers-reduced-motion: no-preference) {
  section.registration.mineaRegistrationReveal .mineacourseEmoji {
    opacity: 0;
    scale: .6;
    transition:
      opacity 800ms cubic-bezier(.16, 1, .3, 1),
      scale 800ms cubic-bezier(.16, 1, .3, 1);
  }

  section.registration.mineaRegistrationVisible .mineacourseEmoji {
    opacity: 1;
    scale: 1;
  }

  section.registration .courseCloud { transition-delay: 120ms; }
  section.registration .coursePencil { transition-delay: 240ms; }
  section.registration .courseLetter { transition-delay: 360ms; }
  section.registration .courseStar { transition-delay: 480ms; }
  section.registration .courseSmile { transition-delay: 600ms; }
}

@media (max-width: 800px) {
  section.registration.mineaRegistrationReveal {
    min-height: 480px;
  }

  section.registration .mineacourseEmoji {
    font-size: 38px;
  }

  section.registration .courseCloud { top: 7%; right: 8%; }
  section.registration .coursePencil { bottom: 8%; right: 17%; }
  section.registration .courseLetter { top: 12%; right: 4%; }
  section.registration .courseStar { left: 5%; bottom: 7%; }
  section.registration .courseSmile { right: 5%; bottom: 22%; }
}

@media (prefers-reduced-motion: reduce) {
  section.registration .mineacourseEmoji {
    animation: none !important;
    opacity: 1 !important;
    scale: 1 !important;
  }
}
